    <!-- About Us Activity -->
    <string name="about_us">Sobre nós</string>
    <string name="about_us_title">Equipa Buge Studio</string>
    <string name="about_us_description">A Equipa Buge Studio é um grupo apaixonado de desenvolvedores e designers dedicados a criar aplicações utilitárias inovadoras e práticas para a plataforma Android. Focamo-nos na privacidade do utilizador, controlo do sistema e abertura. O nosso objetivo é fornecer aos utilizadores ferramentas transparentes, eficientes e fiáveis. Buge App Manager é um projeto open-source e é a nossa primeira aplicação principal. Convidamos todos a participar na sua melhoria e desenvolvimento em conjunto.</string>

