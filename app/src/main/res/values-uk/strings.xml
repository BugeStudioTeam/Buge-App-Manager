    <!-- About Us Activity -->
    <string name="about_us">Про нас</string>
    <string name="about_us_title">Команда Buge Studio</string>
    <string name="about_us_description">Команда Buge Studio — це захоплена група розробників і дизайнерів, які створюють інноваційні та практичні утиліти для платформи Android. Ми зосереджуємося на конфіденційності користувачів, контролі над системою та відкритості. Наша мета — надавати користувачам прозорі, ефективні та надійні інструменти. Buge App Manager — це проєкт з відкритим кодом і наш перший великий застосунок. Ми запрошуємо всіх долучитися до його вдосконалення та розвитку разом.</string>

    <!-- GMS Disable Warning -->
    <string name="gms_disable_warning_title">Вимкнути сервіси Google?</string>
    <string name="gms_disable_warning_message">Вимкнення сервісів Google вплине на таке:\n\n• Google Play Store перестане працювати\n• Застосунки, що залежать від Google Play Services, можуть аварійно завершитися\n• Push-сповіщення від застосунків Google припиняться\n• Служби визначення місцеположення можуть бути порушені\n• Вбудовані покупки не працюватимуть\n\nВи впевнені, що хочете вимкнути сервіси Google?</string>

