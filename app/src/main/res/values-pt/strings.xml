    <!-- About Us Activity -->
    <string name="about_us">Sobre nós</string>
    <string name="about_us_title">Equipa Buge Studio</string>
    <string name="about_us_description">A Equipa Buge Studio é um grupo apaixonado de programadores e designers dedicados a criar aplicações utilitárias inovadoras e práticas para a plataforma Android. Focamo-nos na privacidade do utilizador, no controlo do sistema e na abertura. O nosso objetivo é fornecer aos utilizadores ferramentas transparentes, eficientes e fiáveis. Buge App Manager é um projeto de código aberto e é a nossa primeira grande aplicação. Convidamos todos a participar no seu melhoramento e desenvolvimento em conjunto.</string>

    <!-- GMS Disable Warning -->
    <string name="gms_disable_warning_title">Desativar Serviços Google?</string>
    <string name="gms_disable_warning_message">Desativar os Serviços Google afetará o seguinte:\n\n• A Google Play Store deixará de funcionar\n• Apps que dependem do Google Play Services podem falhar\n• As notificações push das apps Google irão parar\n• Os serviços de localização podem ser afetados\n• As compras dentro da app não funcionarão\n\nTem a certeza de que quer desativar os Serviços Google?</string>

