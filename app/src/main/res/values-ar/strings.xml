    <!-- About Us Activity -->
    <string name="about_us">معلومات عنا</string>
    <string name="about_us_title">فريق Buge Studio</string>
    <string name="about_us_description">فريق Buge Studio هو مجموعة شغوفة من المطورين والمصممين المكرسين لإنشاء تطبيقات أدوات مبتكرة وعملية لمنصة Android. نحن نركز على خصوصية المستخدم والتحكم في النظام والانفتاح. هدفنا هو تزويد المستخدمين بأدوات شفافة وفعالة وموثوقة. Buge App Manager هو مشروع مفتوح المصدر، وهو تطبيقنا الرئيسي الأول. نرحب بالجميع للمشاركة في تحسينه وتطويره معًا.</string>

