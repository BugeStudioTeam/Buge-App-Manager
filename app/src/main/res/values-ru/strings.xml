    <!-- About Us Activity -->
    <string name="about_us">О нас</string>
    <string name="about_us_title">Команда Buge Studio</string>
    <string name="about_us_description">Команда Buge Studio — это увлечённая группа разработчиков и дизайнеров, посвятивших себя созданию инновационных и практичных утилит для платформы Android. Мы уделяем особое внимание конфиденциальности пользователей, контролю над системой и открытости. Наша цель — предоставить пользователям прозрачные, эффективные и надёжные инструменты. Buge App Manager — это проект с открытым исходным кодом и наше первое крупное приложение. Мы приглашаем всех принять участие в его улучшении и развитии.</string>

    <!-- GMS Disable Warning -->
    <string name="gms_disable_warning_title">Отключить сервисы Google?</string>
    <string name="gms_disable_warning_message">Отключение сервисов Google повлияет на следующее:\n\n• Google Play Store перестанет работать\n• Приложения, зависящие от сервисов Google Play, могут вылетать\n• Push-уведомления от приложений Google прекратятся\n• Службы определения местоположения могут быть затронуты\n• Встроенные покупки не будут работать\n\nВы уверены, что хотите отключить сервисы Google?</string>

    <!-- System Operation Blocked -->
    <string name="system_op_blocked_title">Операция заблокирована</string>
    <string name="system_op_blocked_message">Операции с системными приложениями в настоящее время отключены.\n\nВы можете включить «Разрешить операции с системными приложениями» в настройках, чтобы выполнить это действие.</string>

