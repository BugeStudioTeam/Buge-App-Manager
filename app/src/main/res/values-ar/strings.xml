    <!-- About Us Activity -->
    <string name="about_us">من نحن</string>
    <string name="about_us_title">فريق Buge Studio</string>
    <string name="about_us_description">فريق Buge Studio هو مجموعة شغوفة من المطورين والمصممين المكرسين لإنشاء تطبيقات أدوات مبتكرة وعملية لمنصة Android. نركز على خصوصية المستخدم والتحكم في النظام والانفتاح. هدفنا هو تزويد المستخدمين بأدوات شفافة وفعالة وموثوقة. Buge App Manager هو مشروع مفتوح المصدر، وهو أول تطبيق رئيسي لنا. نرحب بالجميع للمشاركة في تحسينه وتطويره معًا.</string>

